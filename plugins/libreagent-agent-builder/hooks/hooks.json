{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/agent_creation_prompt.py",
            "timeout": 5,
            "statusMessage": "Checking for a LibreAgent request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/skill_created.py",
            "timeout": 10,
            "statusMessage": "Checking for a new skill"
          }
        ]
      }
    ]
  }
}
